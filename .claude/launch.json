{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Static dev server (serve)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "public", "-l", "3000"],
      "port": 3000
    },
    {
      "name": "Cloudflare Pages (wrangler)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "pages", "dev", "public"],
      "port": 8788
    }
  ]
}
